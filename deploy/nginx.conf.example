# 将 dist 部署到网站根目录时的参考配置
# 关键：把 root 改成实际 dist 路径后，include 或复制到站点 conf

server {
    listen 80;
    server_name your.domain.com;
    root /var/www/xuanjian/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源可长期缓存（按需）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
